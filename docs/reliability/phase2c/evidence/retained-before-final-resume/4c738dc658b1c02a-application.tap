  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    :root {
      --navy: #24386f;
      --red: #c9232d;
      --green: #0b3529;
      --green-dark: #061f18;
      --green-soft: #174b3b;
      --gold: #d4b15f;
      --gold-soft: #e6cf98;
      --cream: #f5f0e6;
      --paper: #fffdf8;
      --ink: #172019;
      --muted: #6d746f;
      --line: #ddd6c8;
      --shadow: 0 22px 60px rgba(15, 35, 25, 0.10);
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-right: env(safe-area-inset-right, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-left: env(safe-area-inset-left, 0px);
      --app-height: 100vh;
      --participant-header-height: 58px;
      --participant-nav-height: max(68px, 4.25rem);
      --participant-nav-total: calc(var(--participant-nav-height) + var(--safe-bottom));
      --public-site-header-height: max(84px, calc(82px + var(--safe-top)));
    }
    
    @supports (height: 100svh) { :root { --app-height: 100svh; } }
    @supports (height: 100dvh) { :root { --app-height: 100dvh; } }
    
    .liveControlEmbedded {
      min-height: 0 !important;
      padding: 0 0 30px !important;
      background: transparent !important;
    }
    
    * { box-sizing: border-box; }
    
    html {
      min-height: 100%;
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    
    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      overflow-x: clip;
      background: var(--paper);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overscroll-behavior-x: none;
    }
    
    body.participant-app-shell-active { background: var(--green-dark); }
    body.participant-overlay-open { overscroll-behavior: none; }
    body.participant-scoring-focus-active [data-participant-navigation] {
      pointer-events: none;
      opacity: 0;
      transform: translateY(100%);
    }
    
    body.participant-scoring-focus-active .participantAppContent,
    body.participant-scoring-focus-active .participantRouteScene {
      min-height: calc(var(--app-height) - var(--participant-header-height));
    }
    
    .participantAppShell {
      min-height: var(--app-height);
      background: var(--green-dark);
    }
    
    .participantAppContent {
      min-height: calc(var(--app-height) - var(--participant-header-height) - var(--participant-nav-total));
      background: var(--paper);
    }
    
    .participantAppShell .siteHeader,
    .participantAppShell > .participantAppContent footer:not([data-app-footer="true"]) { display: none; }
    
    .participantRouteScene {
      min-height: calc(var(--app-height) - var(--participant-header-height) - var(--participant-nav-total));
      animation: participantRouteEnter .14s ease-out both;
    }
    
    @keyframes participantRouteEnter {
      from { opacity: .78; transform: translateY(2px); }
      to { opacity: 1; transform: none; }
    }
    
    .mobileHomeMain {
      overflow-x: clip;
    }
    
    .mobileHomeLoadError {
      width: min(520px, calc(100% - 32px));
      margin: 28px auto;
      padding: 28px 24px;
      border: 1px solid rgba(166, 125, 45, 0.24);
      border-radius: 18px;
      background: #fffdf8;
      color: var(--ink);
      text-align: center;
    }
    
    .mobileHomeLoadError h1 {
      margin: 0 0 8px;
      color: #0b4435;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.45rem, 6vw, 2rem);
    }
    
    .mobileHomeLoadError p {
      margin: 0;
      color: #68756f;
      line-height: 1.5;
    }
    
    .mobileHomeLoadError button {
      min-height: 44px;
      margin-top: 18px;
      padding: 9px 20px;
      border: 1px solid #0b4435;
      border-radius: 999px;
      background: #0b4435;
      color: #fff;
      font-weight: 800;
    }
    
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }
    button, a, input, select, textarea {
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    button, [role="button"], summary { -webkit-user-select: none; user-select: none; }
    button:disabled { cursor: not-allowed; }
    
    @media (hover: none) and (pointer: coarse) {
      button:active, a:active, summary:active { opacity: .9; transform: scale(.985); }
      input, select, textarea { font-size: max(16px, 1em); }
    }
    
    .siteHeader {
      position: sticky;
      top: 0;
      z-index: 50;
      min-height: 84px;
      padding: calc(12px + env(safe-area-inset-top)) max(5vw, env(safe-area-inset-right)) 12px max(5vw, env(safe-area-inset-left));
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(6, 31, 24, 0.95);
      color: white;
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      backdrop-filter: blur(14px);
    }
    
    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }
    
    .brand img {
      width: 58px;
      height: 58px;
      object-fit: contain;
    }
    
    .brand div {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    
    .brand strong {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.06rem;
    }
    
    .brand span {
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #d6dfda;
    }
    
    .menuButton {
      width: 50px;
      height: 50px;
      padding: 12px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.03);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
    }
    
    .menuButton span {
      display: block;
      width: 100%;
      height: 2px;
      border-radius: 99px;
      background: white;
      transition: opacity .18s ease, transform .18s ease;
    }
    
    .siteHeader .menuButton.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .siteHeader .menuButton.active span:nth-child(2) { opacity: 0; }
    .siteHeader .menuButton.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    
    .menuBackdrop {
      position: fixed;
      inset: var(--public-site-header-height) 0 0;
      z-index: 80;
      background: rgba(0, 0, 0, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.26s ease;
    }
    
    .menuBackdrop.show {
      opacity: 1;
      pointer-events: auto;
    }
    
    @media (max-width: 760px) {
      body.passport-navigation-active {
        padding-bottom: var(--participant-nav-total);
        scroll-padding-bottom: var(--participant-nav-total);
      }
      body.passport-navigation-active.participant-scoring-focus-active {
        padding-bottom: 0;
        scroll-padding-bottom: 0;
      }
    }
    
    @media (max-width: 760px) and (orientation: landscape) {
      :root { --participant-nav-height: 58px; }
    }
    
    
    .sideMenu {
      width: min(100vw, 520px);
      height: var(--app-height);
      max-height: var(--app-height) !important;
      overflow: hidden !important;
      background: var(--green-dark);
      color: white;
      display: flex;
      flex-direction: column;
      box-shadow: -24px 0 70px rgba(0,0,0,.28);
    }
    
    .sideMenu.open { transform: none; }
    .menuDrawerViewport{position:fixed;inset:var(--public-site-header-height) 0 0;z-index:90;overflow:clip;pointer-events:none;contain:layout paint}
    .menuDrawerViewport .sideMenu{position:absolute;top:0;right:0;height:100%;max-height:none!important;visibility:hidden;pointer-events:none;transform:translateX(100%);transition:transform .3s ease,visibility 0s linear .3s}
    .menuDrawerViewport .sideMenu.open{visibility:visible;pointer-events:auto;transform:translateX(0);transition-delay:0s}
    
    .sideMenuTop {
      flex: 0 0 auto;
      min-height: 112px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: calc(26px + env(safe-area-inset-top)) max(32px, env(safe-area-inset-right)) 26px max(32px, env(safe-area-inset-left));
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      background: var(--green-dark);
    }
    
    .sideMenuTop div { display: flex; flex-direction: column; gap: 6px; }
    .sideMenuTop small { color: var(--gold); font-size: .66rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
    .sideMenuTop strong { font-family: Georgia, "Times New Roman", serif; font-size: 1.28rem; }
    .sideMenuTop span { color: #cbd7d1; font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; }
    .sideMenuTop .sideMenuEdition { color: var(--gold); font: 700 .8rem/1.1 Georgia, "Times New Roman", serif; letter-spacing: .06em; text-transform: none; }
    
    .closeMenuButton {
      width: 48px;
      height: 48px;
      border: 0;
      border-radius: 50%;
      background: rgba(255,255,255,.05);
      color: white;
      font-size: 2rem;
      line-height: 1;
      cursor: pointer;
    }
    
    .sideMenuScroll {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      padding: 16px 32px calc(30px + env(safe-area-inset-bottom));
      scrollbar-width: thin;
      scrollbar-color: rgba(212,177,95,.65) transparent;
    }
    
    .sideNav { display: flex; flex-direction: column; }
    .sideNavHome {
      padding: 18px 14px;
      border-bottom: 1px solid rgba(255,255,255,.11);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.55rem;
      border-radius: 10px;
    }
    
    .sideNavGroup { padding: 23px 0 8px; border-bottom: 1px solid rgba(255,255,255,.11); }
    .sideNavGroup h2 {
      margin: 0 0 8px;
      color: var(--gold);
      font-family: Arial, Helvetica, sans-serif;
      font-size: .72rem;
      letter-spacing: .2em;
      text-transform: uppercase;
    }
    .sideNavGroup > div { display: flex; flex-direction: column; gap: 2px; }
    .sideNavGroup a, .sideNavGroup button {
      position: relative;
      width: 100%;
      min-height: 50px;
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: inherit;
      font-family: Arial, Helvetica, sans-serif;
      font-size: .98rem;
      text-align: left;
      text-decoration: none;
      transition: background .18s ease, color .18s ease, transform .18s ease;
    }
    .sideNavGroup a > span, .sideNavGroup button > span { display: grid; width: 28px; height: 28px; place-items: center; font-size: 1rem; }
    .sideNavGroup a > span svg, .sideNavGroup button > span svg { width: 21px; height: 21px; display: block; }
    .sideNavGroup a > b, .sideNavGroup button > b { min-width: 0; font-weight: 750; }
    .sideNavGroup a > i, .sideNavGroup button > i { color: rgba(255,255,255,.5); font: normal 1.45rem/1 Arial, sans-serif; }
    .sideNavGroup button:disabled { opacity: .65; }
    .sideNavSite .sideNavGroup > div { gap: 0; }
    .sideNavSite .sideNavGroup a {
      min-height: 0;
      display: block;
      padding: 13px 14px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.28rem;
    }
    .sideNav a:hover, .sideNav button:hover, .sideNav a.current { background: rgba(255,255,255,.08); color: var(--gold-soft); transform: translateX(3px); }
    .sideNav a.current::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 3px;
      height: 24px;
      border-radius: 99px;
      background: var(--gold);
      transform: translateY(-50%);
    }
    .sideNavDirector { border-bottom: 0; animation: sideNavCapabilityIn .14s ease-out both; }
    .sideNavDirector a { border: 1px solid rgba(212,177,95,.48); color: var(--gold-soft); }
    @keyframes sideNavCapabilityIn { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
    
    .externalLinkDialog {
      width: min(calc(100vw - 36px), 390px);
      padding: 0;
      border: 1px solid rgba(11,73,56,.16);
      border-radius: 22px;
      background: #fffdf8;
      color: #153c31;
      box-shadow: 0 28px 80px rgba(0,0,0,.3);
    }
    .externalLinkDialog::backdrop { background: rgba(4,28,22,.68); backdrop-filter: blur(3px); }
    .externalLinkDialog > div { display: grid; justify-items: center; gap: 10px; padding: 28px 24px 22px; text-align: center; }
    .externalLinkDialog > div > span { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: #f3e6c5; color: #835f12; font-size: 1.25rem; }
    .externalLinkDialog h2, .externalLinkDialog p { margin: 0; }
    .externalLinkDialog h2 { font: 700 1.45rem/1.15 Georgia, serif; }
    .externalLinkDialog p { color: #61706a; font-size: .9rem; }
    .externalLinkDialog > div > div { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .externalLinkDialog button { min-height: 46px; border: 1px solid rgba(11,73,56,.2); border-radius: 12px; background: transparent; color: #0b4938; font-weight: 800; }
    .externalLinkDialog button:last-child { border-color: #0b4938; background: #0b4938; color: white; }
    
    @media (max-width: 560px) {
      .sideMenu { width: 100vw; }
      .sideMenuTop { padding: 22px 24px; min-height: 104px; }
      .sideMenuScroll { padding: 10px 24px calc(26px + env(safe-area-inset-bottom)); }
      .sideNavHome { font-size: 1.42rem; }
      .sideNavGroup { padding-top: 18px; }
      .sideNavGroup a, .sideNavGroup button { font-size: .94rem; padding: 9px 10px; }
      .sideNavSite .sideNavGroup a { font-size: 1.16rem; padding: 11px 12px; }
    }
    
    @media (prefers-reduced-motion: reduce) {
      .sideMenu, .menuBackdrop, .menuButton span, .sideNavGroup a, .sideNavGroup button { transition: none; }
      .sideNavDirector { animation: none; }
      .participantRouteScene { animation: none; }
    }
    
    .kiawahHero {
      height: clamp(700px, calc(100svh - 84px), 780px);
      position: relative;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      color: white;
      background: var(--green-dark);
    }
    
    .kiawahHeroMedia,
    .kiawahHeroImage {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    
    .kiawahHeroImage {
      object-fit: cover;
      object-position: center center;
    }
    
    .kiawahOverlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(3, 20, 15, 0.82) 0%, rgba(3, 20, 15, 0.46) 46%, rgba(3, 20, 15, 0.10) 72%),
        linear-gradient(0deg, rgba(3, 20, 15, 0.68) 0%, transparent 42%);
      z-index: 1;
    }
    
    .kiawahHeroContent {
      position: relative;
      z-index: 2;
      width: min(760px, 88vw);
      padding: 0 0 180px 7vw;
    }
    
    .eyebrow {
      margin: 0 0 16px;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.19em;
      font-weight: 800;
      font-size: 0.75rem;
    }
    
    .eyebrow.dark { color: #846625; }
    
    h1, h2 {
      font-family: Georgia, "Times New Roman", serif;
    }
    
    h1 {
      margin: 0;
      font-size: clamp(4rem, 9vw, 8rem);
      line-height: 0.92;
      letter-spacing: -0.05em;
    }
    
    h2 {
      margin: 0;
      font-size: clamp(2.2rem, 5vw, 4.5rem);
      line-height: 1.02;
      letter-spacing: -0.03em;
    }
    
    .heroDate {
      margin: 20px 0 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.35rem, 3vw, 2.2rem);
    }
    
    .heroIntro {
      max-width: 600px;
      margin: 18px 0 0;
      color: rgba(255,255,255,.88);
      font-size: 1.08rem;
      line-height: 1.7;
    }
    
    .actions {
      margin-top: 30px;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    
    .button {
      min-height: 52px;
      padding: 0 22px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
    }
    
    .button.primary {
      background: var(--gold);
      color: #092b21;
    }
    
    .button.glass {
      border: 1px solid rgba(255,255,255,.55);
      background: rgba(255,255,255,.08);
      backdrop-filter: blur(8px);
    }
    
    .button.guide {
      border: 1px solid rgba(212,177,95,.85);
      background: rgba(6,47,37,.72);
      color: white;
      backdrop-filter: blur(8px);
    }
    
    .button.light {
      background: white;
      color: var(--green);
    }
    
    .heroBottomBar {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      background: rgba(6, 31, 24, 0.88);
      border-top: 1px solid rgba(255,255,255,.14);
      backdrop-filter: blur(10px);
    }
    
    .heroBottomBar div {
      min-height: 118px;
      padding: 26px 30px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-right: 1px solid rgba(255,255,255,.12);
    }
    
    .heroBottomBar div:last-child { border-right: 0; }
    
    .heroBottomBar span {
      color: #cbd7d1;
      font-size: 0.70rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    
    .heroBottomBar strong {
      margin-top: 8px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.2rem;
    }
    
    .mobileTournamentStrip {
      display: none;
    }
    
    .section {
      padding: 92px 7vw;
    }
    
    .sectionCopy {
      max-width: 720px;
      color: var(--muted);
      line-height: 1.8;
      font-size: 1.08rem;
    }
    
    .tournamentSpotlight {
      display: block;
    }
    
    .tournamentSpotlight > div {
      max-width: 860px;
    }
    
    .featureCard {
      overflow: hidden;
      background: white;
      border: 1px solid var(--line);
      border-radius: 20px;
      box-shadow: var(--shadow);
    }
    
    .featureCard div {
      padding: 21px 22px;
      display: flex;
      justify-content: space-between;
      gap: 22px;
      border-bottom: 1px solid var(--line);
    }
    
    .featureCard div:last-child { border-bottom: 0; }
    .featureCard span { color: var(--muted); }
    
    .tournamentPreviewCard {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 22px;
      background: white;
      box-shadow: var(--shadow);
    }
    
    .tournamentPreviewHeader,
    .tournamentPreviewRound {
      padding: 20px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    
    .tournamentPreviewHeader { background: #f5f0e6; }
    .tournamentPreviewHeader span,
    .tournamentPreviewRound span { color: var(--muted); }
    .tournamentPreviewHeader strong {
      padding: 7px 12px;
      border-radius: 999px;
      background: #e5f0eb;
      color: var(--green);
      text-transform: uppercase;
      letter-spacing: .1em;
      font-size: .7rem;
    }
    .tournamentPreviewTeams { padding: 8px 22px; }
    .tournamentPreviewTeams .teamIdentity {
      min-height: 156px;
      padding: 18px 0;
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      align-items: center;
      gap: 28px;
      border-bottom: 1px solid var(--line);
    }
    .tournamentPreviewTeams .teamIdentity:last-child { border-bottom: 0; }
    .teamIdentityContent { min-width: 0; }
    .tournamentPreviewTeams h3 { margin: 0; overflow-wrap: anywhere; font: 700 clamp(1.25rem,2vw,1.7rem)/1.05 Georgia,serif; color: var(--green); }
    .tournamentPreviewTeams p { margin: 5px 0; color: var(--muted); }
    .tournamentPreviewTeams a,.tournamentPreviewRound a { color: var(--green); font-weight: 800; font-size: .84rem; }
    .tournamentPreviewRound { border-top: 1px solid var(--line); }
    .tournamentPreviewRound div { display: flex; flex-direction: column; gap: 4px; }
    
    .liveBand {
      padding: 64px 7vw;
      background: linear-gradient(120deg, var(--navy), #31447f);
      color: white;
      display: grid;
      grid-template-columns: minmax(260px,1.1fr) minmax(500px,1fr) auto;
      gap: 38px;
      align-items: center;
    }
    
    .liveBand p {
      max-width: 640px;
      color: #e1e6f4;
      line-height: 1.7;
    }
    
    .liveScorePreview {
      display: grid;
      grid-template-columns: minmax(180px,1fr) minmax(110px,.65fr) minmax(180px,1fr);
      gap: 22px;
      align-items: center;
      text-align: center;
    }
    
    .liveScorePreview div {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    
    .liveScorePreview span {
      min-height: 2.4em;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      text-wrap: balance;
      line-height: 1.2;
      font-size: .74rem;
      letter-spacing: .10em;
      text-transform: uppercase;
    }
    
    .liveScorePreview strong {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 3rem;
    }
    
    .liveScorePreview p {
      margin: 0;
      font-size: .8rem;
      color: #cfd7ec;
    }
    
    .cupSection {
      background:
        radial-gradient(circle at 85% 10%, rgba(212,177,95,.13), transparent 28%),
        var(--green);
      color: white;
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 68px;
      align-items: center;
    }
    
    .cupPhoto img {
      width: 100%;
      max-height: 680px;
      object-fit: cover;
      border-radius: 22px;
      box-shadow: 0 28px 60px rgba(0,0,0,.28);
    }
    
    .cupCopy p {
      color: #dbe5df;
      line-height: 1.8;
      font-size: 1.1rem;
    }
    
    .textLink {
      display: inline-block;
      margin-top: 18px;
      color: var(--gold);
      font-weight: 800;
    }
    
    .darkLink {
      margin-top: 0;
      color: var(--green);
    }
    
    .historyPreview {
      background: var(--cream);
    }
    
    .sectionHeading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 25px;
    }
    
    .yearGrid {
      margin-top: 40px;
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 16px;
    }
    
    .yearCard {
      min-width: 0;
      min-height: 240px;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: white;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }
    
    .yearCardLogo {
      flex: 0 0 auto;
      width: 72px;
      height: 72px;
      padding: 9px;
      display: grid;
      place-items: center;
      border: 1px solid #dfd3bd;
      border-radius: 50%;
      background: #fffaf0;
    }
    .yearCardLogo img { width: 100%; height: 100%; object-fit: contain; }
    .yearCardLogo + .yearCardYear { margin-top: 14px; }
    
    .yearCardYear {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2.1rem;
    }
    
    .yearCard .yearCardStatus {
      align-self: flex-start;
      flex: 0 0 auto;
      width: max-content;
      max-width: 100%;
      min-width: 0;
      overflow: hidden;
      font: 900 .62rem/1 Arial, sans-serif;
      white-space: nowrap;
    }
    
    .yearCard strong {
      color: var(--muted);
      font-size: 0.82rem;
    }
    
    footer {
      padding: 38px 7vw;
      background: var(--green-dark);
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
    }
    
    footer div {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    
    footer span {
      color: #cbd7d1;
      font-size: 0.84rem;
    }
    
    @media (max-width: 980px) {
      .kiawahHero {
        height: clamp(580px, 72svh, 650px);
      }
    
      .kiawahHeroImage {
        object-position: 55% center;
      }
    
      .tournamentSpotlight,
      .cupSection,
      .liveBand {
        grid-template-columns: 1fr;
      }
    
      .liveBand { gap: 28px; text-align: center; }
      .liveBand > div:first-child { justify-self: center; }
      .liveScorePreview { width: min(620px,100%); justify-self: center; }
    
      .yearGrid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    
    @media (max-width: 1180px) {
      .liveBand {
        grid-template-columns: 1fr;
        gap: 28px;
        text-align: center;
      }
    
      .liveBand > div:first-child,
      .liveScorePreview {
        justify-self: center;
      }
    
      .liveScorePreview {
        width: min(620px, 100%);
      }
    }
    
    @media (max-width: 640px) {
      :root {
        --public-site-header-height: calc(72px + var(--safe-top));
      }
    
      .siteHeader {
        min-height: 72px;
      }
    
      .brand img {
        width: 48px;
        height: 48px;
      }
    
      .brand strong {
        font-size: .93rem;
      }
    
      .kiawahHero {
        height: clamp(480px, 68svh, 540px);
        min-height: 480px;
      }
    
      .kiawahHeroImage {
        object-position: 60% center;
      }
    
      .kiawahHeroContent {
        width: auto;
        padding: 52px 6vw 42px;
      }
    
      .heroBottomBar {
        display: none;
      }
    
      .kiawahHeroContent h1 {
        max-width: 94vw;
        font-size: clamp(2.8rem, 13vw, 4.35rem);
        line-height: .94;
      }
    
      .heroDate {
        margin-top: 13px;
        font-size: clamp(1.12rem, 5vw, 1.48rem);
      }
    
      .heroIntro {
        margin-top: 12px;
        font-size: .94rem;
        line-height: 1.45;
      }
    
      .actions {
        margin-top: 20px;
      }
    
      .mobileTournamentStrip {
        min-height: 58px;
        padding: 12px 5vw;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px 10px;
        background: var(--green-dark);
        color: #fffaf0;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .035em;
        text-align: center;
      }
    
      .mobileTournamentStrip span:not(:last-child)::after {
        content: " •";
        margin-left: 10px;
        color: var(--gold);
      }
    
      .section {
        padding: 68px 6vw;
      }
    
      .liveBand {
        padding: 56px 6vw;
      }
    
      .liveScorePreview {
        grid-template-columns: 1fr;
      }
    
      .liveScorePreview span { min-height: 0; }
    
      .tournamentPreviewTeams .teamIdentity {
        min-height: 260px;
        grid-template-columns: 1fr;
        justify-items: center;
        gap: 16px;
        text-align: center;
      }
    
      .sectionHeading,
      footer {
        align-items: flex-start;
        flex-direction: column;
      }
    
      .yearGrid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    
      .sideMenu {
        width: 100vw;
      }
    }
    
    
    /* =========================================================
       V8.1 â€” MOBILE HERO CTA VISIBILITY
       ========================================================= */
    
    @media (max-width: 640px) {
      .kiawahHeroContent .actions {
        width: 100%;
        flex-wrap: wrap;
      }
    
      .kiawahHeroContent .button {
        min-height: 46px;
        padding: 0 16px;
        font-size: .82rem;
        flex: 1 1 145px;
      }
    }
    
    @media (max-width: 390px) {
      .kiawahHeroContent .actions {
        flex-wrap: wrap;
      }
    
      .kiawahHeroContent .button {
        flex: 1 1 100%;
      }
    }
    
    
    /* =========================================================
       V8.1.1 â€” HOMEPAGE HISTORY DETAILS
       ========================================================= */
    
    .yearCard p {
      margin: 12px 0 auto;
      color: var(--muted);
      font-size: .82rem;
      line-height: 1.35;
    }
    
    .yearCard strong {
      margin-top: 20px;
    }
    
    /* Shared loading and error states */
    .appLoading, .appError {
      min-height: 100vh;
      background: var(--paper);
      padding: 8vh 7vw;
    }
    .loadingBrand { color: var(--green); font-family: Georgia, "Times New Roman", serif; font-weight: 700; font-size: 1.25rem; }
    .loadingShell { max-width: 1100px; margin: 60px auto 0; }
    .skeleton { background: linear-gradient(90deg, #eee8dd 20%, #faf7ef 45%, #eee8dd 70%); background-size: 240% 100%; animation: skeletonMove 1.35s linear infinite; border-radius: 16px; }
    .skeletonTitle { width: min(560px, 80%); height: 72px; }
    .skeletonLine { width: min(700px, 94%); height: 20px; margin-top: 22px; }
    .skeletonLine.short { width: min(440px, 70%); }
    .loadingGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 52px; }
    .loadingCard { height: 300px; }
    @keyframes skeletonMove { to { background-position: -240% 0; } }
    .errorCard { max-width: 680px; margin: 10vh auto; padding: 48px; border: 1px solid var(--line); border-radius: 28px; background: white; box-shadow: var(--shadow); }
    .errorCard span { color: #846625; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; font-size: .75rem; }
    .errorCard h1 { margin-top: 18px; font-size: clamp(2.5rem, 6vw, 4.6rem); }
    .errorCard p { color: var(--muted); line-height: 1.7; }
    .errorCard button { margin-top: 18px; min-height: 50px; padding: 0 24px; border: 0; border-radius: 999px; background: var(--green); color: white; font-weight: 800; cursor: pointer; }
    @media (max-width: 760px) { .loadingGrid { grid-template-columns: 1fr; } .errorCard { padding: 30px 24px; } }
    
    @media (display-mode: standalone) {
      body { min-height: 100dvh; }
    }
    
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
    :root {
      --tournament-green: #0b523f;
      --tournament-gold: #b58a25;
      --status-live-red: #c83239;
      --status-upcoming-gray: #66716c;
      --status-final-neutral: #174635;
      --status-locked-neutral: #4c5a54;
    }
    body.preview-impersonation-active{padding-top:54px}
    body.preview-impersonation-active.participant-scoring-focus-active{padding-top:44px;--participant-header-height:48px}
    body.preview-impersonation-active.participant-scoring-focus-active [data-preview-mode-badge]{display:none}
    .directorTransactionLock{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;padding:24px;background:rgba(5,28,22,.48);backdrop-filter:blur(3px);pointer-events:all}.directorTransactionLock>div{display:grid;gap:6px;width:min(360px,100%);padding:26px 24px;border:1px solid rgba(189,150,62,.45);border-radius:20px;background:#fffdf8;color:#163c31;text-align:center;box-shadow:0 22px 60px rgba(0,0,0,.24)}.directorTransactionLock strong{font-family:Georgia,"Times New Roman",serif;font-size:1.45rem}.directorTransactionLock span{color:#68756f;font-weight:700}
    .directorTransactionLock ol{display:grid;gap:7px;margin:14px 0 0;padding:14px 0 0;border-top:1px solid rgba(22,60,49,.12);list-style:none;text-align:left}.directorTransactionLock li{color:#87918d;font-size:.73rem;font-weight:800}.directorTransactionLock li[data-state=complete]{color:#5d756d}.directorTransactionLock li[data-state=active]{color:#9a7020}
    .pwaInstallGuidance>div{display:grid;gap:4px;padding:4px 6px}.pwaInstallGuidance>div>strong{font-size:.8rem}.pwaInstallGuidance ol{display:flex;gap:5px;margin:0;padding:0;list-style:none;font-size:.72rem}.pwaInstallGuidance li:not(:last-child)::after{margin-left:5px;color:#a17b25;content:"→"}@media(max-width:390px){.pwaInstallGuidance ol{align-items:flex-start;flex-direction:column;gap:2px}.pwaInstallGuidance li:not(:last-child)::after{content:"↓"}}
    
