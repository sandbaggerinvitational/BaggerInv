    .brand img {
      width: 58px;
      height: 58px;
      object-fit: contain;
    }
    
    .brand div {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    
    .brand strong {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.06rem;
