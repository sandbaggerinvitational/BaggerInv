      border-radius: 99px;
      background: white;
      transition: opacity .18s ease, transform .18s ease;
    }
    
    .siteHeader .menuButton.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .siteHeader .menuButton.active span:nth-child(2) { opacity: 0; }
    .siteHeader .menuButton.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    
    .menuBackdrop {
      position: fixed;
      inset: var(--public-site-header-height) 0 0;
      z-index: 80;
      background: rgba(0, 0, 0, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.26s ease;
