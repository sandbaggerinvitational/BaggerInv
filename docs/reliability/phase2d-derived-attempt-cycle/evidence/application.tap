  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    :root {
      --navy: #24386f;
      --red: #c9232d;
      --green: #0b3529;
      --green-dark: #061f18;
      --green-soft: #174b3b;
      --gold: #d4b15f;
      --gold-soft: #e6cf98;
      --cream: #f5f0e6;
      --paper: #fffdf8;
      --ink: #172019;
      --muted: #6d746f;
      --line: #ddd6c8;
      --shadow: 0 22px 60px rgba(15, 35, 25, 0.10);
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-right: env(safe-area-inset-right, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-left: env(safe-area-inset-left, 0px);
      --app-height: 100vh;
      --participant-header-height: 58px;
      --participant-nav-height: max(68px, 4.25rem);
      --participant-nav-total: calc(var(--participant-nav-height) + var(--safe-bottom));
      --public-site-header-height: max(84px, calc(82px + var(--safe-top)));
    }
    
    @supports (height: 100svh) { :root { --app-height: 100svh; } }
    @supports (height: 100dvh) { :root { --app-height: 100dvh; } }
    
    .liveControlEmbedded {
      min-height: 0 !important;
      padding: 0 0 30px !important;
      background: transparent !important;
    }
    
    * { box-sizing: border-box; }
    
    html {
      min-height: 100%;
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    
    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      overflow-x: clip;
      background: var(--paper);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overscroll-behavior-x: none;
    }
    
    body.participant-app-shell-active { background: var(--green-dark); }
    body.participant-overlay-open { overscroll-behavior: none; }
    body.participant-scoring-focus-active [data-participant-navigation] {
      pointer-events: none;
      opacity: 0;
      transform: translateY(100%);
    }
    
    body.participant-scoring-focus-active .participantAppContent,
    body.participant-scoring-focus-active .participantRouteScene {
      min-height: calc(var(--app-height) - var(--participant-header-height));
    }
    
    .participantAppShell {
      min-height: var(--app-height);
      background: var(--green-dark);
    }
    
    .participantAppContent {
      min-height: calc(var(--app-height) - var(--participant-header-height) - var(--participant-nav-total));
      background: var(--paper);
    }
    
    .participantAppShell .siteHeader,
    .participantAppShell > .participantAppContent footer:not([data-app-footer="true"]) { display: none; }
    
    .participantRouteScene {
      min-height: calc(var(--app-height) - var(--participant-header-height) - var(--participant-nav-total));
      animation: participantRouteEnter .14s ease-out both;
    }
    
    @keyframes participantRouteEnter {
      from { opacity: .78; transform: translateY(2px); }
      to { opacity: 1; transform: none; }
    }
    
    .mobileHomeMain {
      overflow-x: clip;
    }
    
    .mobileHomeLoadError {
      width: min(520px, calc(100% - 32px));
      margin: 28px auto;
      padding: 28px 24px;
      border: 1px solid rgba(166, 125, 45, 0.24);
      border-radius: 18px;
      background: #fffdf8;
