{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagger:mobile:v1:records",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "apiVersion", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "categories"],
      "properties": {
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["firstCompleteMatchYear", "scorecardHistoryComplete", "note"],
          "properties": {
            "firstCompleteMatchYear": { "type": "integer", "minimum": 2017, "maximum": 2026 },
            "scorecardHistoryComplete": { "type": "boolean" },
            "note": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        },
        "categories": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/category" } }
      }
    },
    "meta": { "$ref": "shared.schema.json#/$defs/meta" }
  },
  "$defs": {
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityType", "playerIds", "displayName", "participantNames", "teamId", "teamName", "courseId", "courseName", "holeNumber", "matchId", "year", "roundNumber", "format", "value", "valueDisplay", "secondaryValue"],
      "properties": {
        "entityType": { "enum": ["PLAYER", "TEAM_PERFORMANCE", "COURSE_HOLE", "MATCH_PERFORMANCE"] },
        "playerIds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" } },
        "displayName": { "type": ["string", "null"], "maxLength": 200 },
        "participantNames": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "teamId": { "type": ["string", "null"], "maxLength": 128 },
        "teamName": { "type": ["string", "null"], "maxLength": 160 },
        "courseId": { "type": ["string", "null"], "maxLength": 128 },
        "courseName": { "type": ["string", "null"], "maxLength": 160 },
        "holeNumber": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
        "matchId": { "type": ["string", "null"], "maxLength": 128 },
        "year": { "type": ["integer", "null"], "minimum": 2017, "maximum": 2026 },
        "roundNumber": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
        "format": { "type": ["string", "null"], "maxLength": 16 },
        "value": { "type": ["number", "string", "null"], "maxLength": 128 },
        "valueDisplay": { "type": ["string", "null"], "maxLength": 160 },
        "secondaryValue": { "type": ["number", "null"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "title", "source", "direction", "unit", "decimals", "signed", "aggregate", "eligibilityNote", "value", "valueDisplay", "tied", "holders"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "enum": ["OFFICIAL", "SCORECARD", "MATCH_PROGRESSION"] },
        "direction": { "enum": ["highest", "lowest"] },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 8 },
        "signed": { "type": "boolean" },
        "aggregate": { "type": "boolean" },
        "eligibilityNote": { "type": ["string", "null"], "maxLength": 240 },
        "value": { "type": ["number", "string", "null"], "maxLength": 128 },
        "valueDisplay": { "type": ["string", "null"], "maxLength": 160 },
        "tied": { "type": "boolean" },
        "holders": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/holder" } }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryId", "title", "order", "records"],
      "properties": {
        "categoryId": { "enum": ["ALL_TIME", "INDIVIDUAL", "TEAM", "COURSE_HOLE", "ADVANCED", "MATCH_PLAY", "MATCH_PROGRESSION"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "order": { "type": "integer", "minimum": 0, "maximum": 9 },
        "records": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/record" } }
      }
    }
  }
}
