{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagger:mobile:v1:guide",
  "title": "Bagger Mobile API v1 participant Tournament Guide response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "apiVersion", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion", "tournamentId", "publicationState", "publishedAt",
        "tournament", "overview", "rules", "courses", "dining", "localGuide", "contacts"
      ],
      "properties": {
        "contractVersion": { "const": "guide-v1" },
        "tournamentId": { "$ref": "#/$defs/id" },
        "publicationState": { "$ref": "#/$defs/publicationState" },
        "publishedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "tournament": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/tournament" }
          ]
        },
        "overview": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/overviewSection" }
        },
        "rules": { "$ref": "#/$defs/rules" },
        "courses": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/course" }
        },
        "dining": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/dining" }
        },
        "localGuide": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/localGuide" }
        },
        "contacts": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/contact" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "publicationState": { "const": "UNPUBLISHED" } },
            "required": ["publicationState"]
          },
          "then": {
            "properties": {
              "publishedAt": { "type": "null" },
              "tournament": { "type": "null" },
              "overview": { "maxItems": 0 },
              "rules": {
                "properties": {
                  "roundFormats": { "maxItems": 0 },
                  "items": { "maxItems": 0 }
                }
              },
              "courses": { "maxItems": 0 },
              "dining": { "maxItems": 0 },
              "localGuide": { "maxItems": 0 },
              "contacts": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "publicationState": { "const": "PUBLISHED" } },
            "required": ["publicationState"]
          },
          "then": {
            "properties": {
              "publishedAt": { "$ref": "#/$defs/timestamp" },
              "tournament": { "$ref": "#/$defs/tournament" }
            }
          }
        }
      ]
    },
    "meta": { "$ref": "shared.schema.json#/$defs/meta" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "publicationState": { "enum": ["UNPUBLISHED", "PUBLISHED"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/timestamp" }
      ]
    },
    "nullableText": { "type": ["string", "null"], "maxLength": 20000 },
    "nullableShortText": { "type": ["string", "null"], "maxLength": 500 },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "nullableBoolean": { "type": ["boolean", "null"] },
    "nullableHttpsUrl": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "nullableAssetKey": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
      "maxLength": 240
    },
    "tournament": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tournamentId", "year", "name", "editionTitle", "dates", "location", "timeZone",
        "logoAssetKey", "heroAssetKey", "mobileHeroAssetKey"
      ],
      "properties": {
        "tournamentId": { "$ref": "#/$defs/id" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "editionTitle": { "$ref": "#/$defs/nullableShortText" },
        "dates": { "$ref": "#/$defs/nullableShortText" },
        "location": { "$ref": "#/$defs/nullableShortText" },
        "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "logoAssetKey": { "$ref": "#/$defs/nullableAssetKey" },
        "heroAssetKey": { "$ref": "#/$defs/nullableAssetKey" },
        "mobileHeroAssetKey": { "$ref": "#/$defs/nullableAssetKey" }
      }
    },
    "overviewSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "slug", "title", "body", "sortOrder"],
      "properties": {
        "sectionId": { "$ref": "#/$defs/id" },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "title": { "$ref": "#/$defs/nullableShortText" },
        "body": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundFormats", "items"],
      "properties": {
        "roundFormats": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/roundFormat" }
        },
        "items": {
          "type": "array",
          "maxItems": 300,
          "items": { "$ref": "#/$defs/ruleItem" }
        }
      }
    },
    "roundFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roundNumber", "format", "name", "teamSize", "pointsAvailable",
        "frontNineUsed", "frontNinePoints", "backNineUsed", "backNinePoints",
        "overallUsed", "overallPoints", "description", "rules", "handicapAllocation",
        "handicap", "handicapRules", "playingHandicap", "scoringFormat", "scoring", "matchFormat"
      ],
      "properties": {
        "roundNumber": { "type": "integer", "minimum": 1, "maximum": 99 },
        "format": { "enum": ["BB", "SC", "SI"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "teamSize": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
        "pointsAvailable": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "frontNineUsed": { "$ref": "#/$defs/nullableBoolean" },
        "frontNinePoints": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "backNineUsed": { "$ref": "#/$defs/nullableBoolean" },
        "backNinePoints": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "overallUsed": { "$ref": "#/$defs/nullableBoolean" },
        "overallPoints": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "description": { "$ref": "#/$defs/nullableText" },
        "rules": { "$ref": "#/$defs/nullableText" },
        "handicapAllocation": { "$ref": "#/$defs/nullableText" },
        "handicap": { "$ref": "#/$defs/nullableText" },
        "handicapRules": { "$ref": "#/$defs/nullableText" },
        "playingHandicap": { "$ref": "#/$defs/nullableText" },
        "scoringFormat": { "$ref": "#/$defs/nullableText" },
        "scoring": { "$ref": "#/$defs/nullableText" },
        "matchFormat": { "$ref": "#/$defs/nullableText" }
      }
    },
    "ruleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId", "category", "subcategory", "title", "body", "sortOrder", "effectiveYear", "important"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/id" },
        "category": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subcategory": { "type": ["string", "null"], "maxLength": 160 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "body": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "effectiveYear": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2200 },
        "important": { "type": "boolean" }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseId", "name", "city", "state", "location", "yearOpened", "designer",
        "website", "directionsUrl", "logoAssetKey", "profileAssetKey", "overview",
        "playingTips", "signatureHoles", "history", "assignments"
      ],
      "properties": {
        "courseId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "city": { "type": ["string", "null"], "maxLength": 160 },
        "state": { "type": ["string", "null"], "maxLength": 160 },
        "location": { "$ref": "#/$defs/nullableShortText" },
        "yearOpened": { "type": ["integer", "null"], "minimum": 1700, "maximum": 2200 },
        "designer": { "$ref": "#/$defs/nullableShortText" },
        "website": { "$ref": "#/$defs/nullableHttpsUrl" },
        "directionsUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
        "logoAssetKey": { "$ref": "#/$defs/nullableAssetKey" },
        "profileAssetKey": { "$ref": "#/$defs/nullableAssetKey" },
        "overview": { "$ref": "#/$defs/nullableText" },
        "playingTips": { "$ref": "#/$defs/nullableText" },
        "signatureHoles": { "$ref": "#/$defs/nullableText" },
        "history": { "$ref": "#/$defs/nullableText" },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/courseAssignment" }
        }
      }
    },
    "courseAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId", "roundNumber", "format", "tee", "rating", "slope", "par", "yardage", "holes"
      ],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/id" },
        "roundNumber": { "type": "integer", "minimum": 1, "maximum": 99 },
        "format": { "enum": ["BB", "SC", "SI"] },
        "tee": { "type": "string", "minLength": 1, "maxLength": 160 },
        "rating": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "slope": { "type": "integer", "minimum": 1, "maximum": 300 },
        "par": { "type": "integer", "minimum": 1, "maximum": 200 },
        "yardage": { "type": ["integer", "null"], "minimum": 1, "maximum": 20000 },
        "holes": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": { "$ref": "#/$defs/hole" }
        }
      }
    },
    "hole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holeNumber", "par", "yardage", "strokeIndex"],
      "properties": {
        "holeNumber": { "type": "integer", "minimum": 1, "maximum": 18 },
        "par": { "type": "integer", "minimum": 1, "maximum": 9 },
        "yardage": { "type": ["integer", "null"], "minimum": 1, "maximum": 1500 },
        "strokeIndex": { "type": "integer", "minimum": 1, "maximum": 18 }
      }
    },
    "dining": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diningId", "year", "day", "meal", "cuisine", "startTime", "endTime",
        "location", "dressCode", "reservationRequired", "notes", "sortOrder"
      ],
      "properties": {
        "diningId": { "$ref": "#/$defs/id" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "day": { "type": "string", "minLength": 1, "maxLength": 160 },
        "meal": { "type": "string", "minLength": 1, "maxLength": 240 },
        "cuisine": { "$ref": "#/$defs/nullableShortText" },
        "startTime": { "type": ["string", "null"], "maxLength": 80 },
        "endTime": { "type": ["string", "null"], "maxLength": 80 },
        "location": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dressCode": { "$ref": "#/$defs/nullableShortText" },
        "reservationRequired": { "$ref": "#/$defs/nullableBoolean" },
        "notes": { "type": ["string", "null"], "maxLength": 10000 },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "localGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId", "year", "category", "title", "description", "address", "phone", "website", "sortOrder"
      ],
      "properties": {
        "entryId": { "$ref": "#/$defs/id" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "category": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "$ref": "#/$defs/nullableText" },
        "address": { "type": ["string", "null"], "maxLength": 1000 },
        "phone": { "$ref": "#/$defs/nullablePhone" },
        "website": { "$ref": "#/$defs/nullableHttpsUrl" },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contactId", "year", "category", "name", "role", "phone", "textEnabled", "email", "website", "sortOrder"
      ],
      "properties": {
        "contactId": { "$ref": "#/$defs/id" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "category": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "role": { "$ref": "#/$defs/nullableShortText" },
        "phone": { "$ref": "#/$defs/nullablePhone" },
        "textEnabled": { "type": "boolean" },
        "email": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "email", "maxLength": 254 }
          ]
        },
        "website": { "$ref": "#/$defs/nullableHttpsUrl" },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "nullablePhone": {
      "type": ["string", "null"],
      "pattern": "^\\+?[0-9() .,#-]+(?: *(?:[xX]|[eE][xX][tT]\\.?) *[0-9]{1,8})?$",
      "maxLength": 80
    }
  }
}
