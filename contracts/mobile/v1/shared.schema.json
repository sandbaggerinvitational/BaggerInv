{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagger:mobile:v1:shared",
  "$defs": {
    "meta": { "type": "object", "additionalProperties": false, "required": ["generatedAt", "revision"], "properties": { "generatedAt": { "type": "string", "format": "date-time" }, "revision": { "type": ["string", "null"] } } },
    "team": { "type": "object", "additionalProperties": false, "required": ["teamId", "name"], "properties": { "teamId": { "type": ["string", "null"] }, "name": { "type": "string" } } },
    "player": { "type": "object", "additionalProperties": false, "required": ["playerId", "displayName", "team"], "properties": { "playerId": { "type": "string", "minLength": 1 }, "displayName": { "type": "string", "minLength": 1 }, "team": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/team" }] } } },
    "tournament": { "type": "object", "additionalProperties": false, "required": ["tournamentId", "name", "year", "status", "currentRound", "timeZone"], "properties": { "tournamentId": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "year": { "type": ["integer", "null"] }, "status": { "type": ["string", "null"] }, "currentRound": { "type": ["integer", "null"] }, "timeZone": { "type": "string", "minLength": 1 } } },
    "event": { "type": "object", "additionalProperties": false, "required": ["eventId", "date", "startAt", "endAt", "localStartTime", "localEndTime", "title", "subtitle", "location", "type"], "properties": { "eventId": { "type": ["string", "null"] }, "date": { "type": ["string", "null"], "format": "date" }, "startAt": { "type": ["string", "null"], "format": "date-time" }, "endAt": { "type": ["string", "null"], "format": "date-time" }, "localStartTime": { "type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}:\\d{2}$" }, "localEndTime": { "type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}:\\d{2}$" }, "title": { "type": "string" }, "subtitle": { "type": ["string", "null"] }, "location": { "type": ["string", "null"] }, "type": { "type": ["string", "null"] } } },
    "match": { "type": "object", "additionalProperties": false, "required": ["matchId", "round", "status", "course", "teeTime", "teams", "authenticatedPlayer", "progress", "result"], "properties": { "matchId": { "type": "string", "minLength": 1 }, "round": { "type": "object" }, "status": { "enum": ["scheduled", "inProgress", "completed"] }, "course": { "type": ["object", "null"] }, "teeTime": { "type": ["object", "null"] }, "teams": { "type": "array", "minItems": 2, "maxItems": 2 }, "authenticatedPlayer": { "type": "object" }, "progress": { "type": ["object", "null"] }, "result": { "type": ["object", "null"] } } }
  }
}
