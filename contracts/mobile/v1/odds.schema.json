{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagger:mobile:v1:odds",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "apiVersion", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "snapshots"],
      "properties": {
        "publication": { "$ref": "#/$defs/publication" },
        "snapshots": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/snapshot" } }
      },
      "allOf": [
        {
          "if": { "properties": { "publication": { "properties": { "state": { "const": "UNPUBLISHED" } } } } },
          "then": {
            "properties": {
              "publication": {
                "properties": {
                  "publishedAt": { "type": "null" },
                  "currentPhase": { "type": "null" }
                }
              },
              "snapshots": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "publication": { "properties": { "state": { "const": "PUBLISHED" } } } } },
          "then": {
            "properties": {
              "publication": {
                "properties": {
                  "publishedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                  "currentPhase": { "$ref": "#/$defs/phase" }
                }
              },
              "snapshots": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "meta": { "$ref": "shared.schema.json#/$defs/meta" }
  },
  "$defs": {
    "phase": { "enum": ["Pre-Tournament", "After Round 1", "After Round 2", "Round 3 Pairings Announced", "Final Results"] },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "revision", "publishedAt", "currentPhase"],
      "properties": {
        "state": { "enum": ["UNPUBLISHED", "PUBLISHED"] },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "publishedAt": { "type": ["string", "null"], "format": "date-time", "maxLength": 40 },
        "currentPhase": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/phase" }] }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "teamId", "name", "probability", "americanOdds", "expectedPoints"],
      "properties": {
        "side": { "type": "integer", "minimum": 1, "maximum": 2 },
        "teamId": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "probability": { "type": "number", "minimum": 0, "maximum": 100 },
        "americanOdds": { "type": "string", "minLength": 2, "maxLength": 8, "pattern": "^(?:[+-][0-9]{1,6}|[+-]∞)$" },
        "expectedPoints": { "type": "number", "minimum": 0 }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "playerId", "displayName", "teamSide", "probability", "americanOdds", "expectedPoints", "expectedRecord", "averageFinish"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 64 },
        "playerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "teamSide": { "type": "integer", "minimum": 1, "maximum": 2 },
        "probability": { "type": "number", "minimum": 0, "maximum": 100 },
        "americanOdds": { "type": "string", "minLength": 2, "maxLength": 8, "pattern": "^(?:[+-][0-9]{1,6}|[+-]∞)$" },
        "expectedPoints": { "type": "number", "minimum": 0 },
        "expectedRecord": { "type": "string", "minLength": 5, "maxLength": 64, "pattern": "^\\d+(?:\\.\\d+)?-\\d+(?:\\.\\d+)?-\\d+(?:\\.\\d+)?$" },
        "averageFinish": { "type": "number", "minimum": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "phaseOrder", "label", "isCurrent", "publishedAt", "iterations", "totalPointsAvailable", "teams", "players"],
      "properties": {
        "phase": { "$ref": "#/$defs/phase" },
        "phaseOrder": { "type": "integer", "minimum": 0, "maximum": 4 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "isCurrent": { "type": "boolean" },
        "publishedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 100000000 },
        "totalPointsAvailable": { "type": "number", "minimum": 0 },
        "teams": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/team" } },
        "players": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/player" } }
      }
    }
  }
}
