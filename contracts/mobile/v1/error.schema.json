{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagger:mobile:v1:error",
  "title": "Bagger Mobile API v1 error response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "apiVersion", "error"],
  "properties": {
    "ok": { "const": false },
    "apiVersion": { "const": "v1" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "UNAUTHORIZED",
            "INVALID_TOKEN",
            "PARTICIPANT_NOT_FOUND",
            "MOBILE_API_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
