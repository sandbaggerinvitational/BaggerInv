{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagger:mobile:v1:scoring-shared",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "winner": { "type": ["string", "null"], "enum": ["teamOne", "teamTwo", "halved", null] },
    "grossScores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "numericScores": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt"],
      "properties": { "generatedAt": { "type": "string", "format": "date-time" } }
    },
    "hole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holeNumber", "revision", "gross", "strokes", "net", "winner", "updatedAt"],
      "properties": {
        "holeNumber": { "type": "integer", "minimum": 1, "maximum": 18 },
        "revision": { "$ref": "#/$defs/revision" },
        "gross": {
          "type": "object",
          "additionalProperties": false,
          "required": ["teamOne", "teamTwo"],
          "properties": {
            "teamOne": { "$ref": "#/$defs/grossScores" },
            "teamTwo": { "$ref": "#/$defs/grossScores" }
          }
        },
        "strokes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["teamOne", "teamTwo"],
          "properties": {
            "teamOne": { "$ref": "#/$defs/numericScores" },
            "teamTwo": { "$ref": "#/$defs/numericScores" }
          }
        },
        "net": {
          "type": "object",
          "additionalProperties": false,
          "required": ["teamOne", "teamTwo"],
          "properties": {
            "teamOne": { "type": ["number", "null"] },
            "teamTwo": { "type": ["number", "null"] }
          }
        },
        "winner": { "$ref": "#/$defs/winner" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
