{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagger:mobile:v1:scoring-finalize-response",
  "title": "Bagger Mobile API v1 authoritative finalization acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "apiVersion", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationId", "accepted", "idempotent", "match", "refreshRequired"],
      "properties": {
        "mutationId": { "$ref": "scoring-shared.schema.json#/$defs/identifier" },
        "accepted": { "const": true },
        "idempotent": { "type": "boolean" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matchId", "revision", "permissionRevision", "status", "scoringLocked", "result", "finalizedAt"],
          "properties": {
            "matchId": { "$ref": "scoring-shared.schema.json#/$defs/identifier" },
            "revision": { "$ref": "scoring-shared.schema.json#/$defs/revision" },
            "permissionRevision": { "oneOf": [{ "$ref": "scoring-shared.schema.json#/$defs/revision" }, { "type": "null" }] },
            "status": { "const": "completed" },
            "scoringLocked": { "const": true },
            "result": { "$ref": "scoring-shared.schema.json#/$defs/winner" },
            "finalizedAt": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "refreshRequired": { "const": true }
      }
    },
    "meta": { "$ref": "scoring-shared.schema.json#/$defs/meta" }
  }
}
