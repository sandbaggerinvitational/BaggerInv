{
  "name": "bagger-inv",
  "version": "12.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test",
    "test:reliability": "node tools/reliability/certify-phase1.mjs",
    "test:reliability:sql": "node tools/reliability/certify-phase1.mjs --sql",
    "test:reliability:native-candidate": "node --test tools/reliability/native-never-again/candidate-gate.mjs",
    "benchmark:reliability": "node tools/reliability/benchmark-history.mjs --samples 30 --scales 1,2,5,10",
    "benchmark:reliability:processors": "node tools/reliability/benchmark-sidegame-processors.mjs --samples 30",
    "benchmark:reliability:telemetry": "node tools/reliability/benchmark-telemetry-overhead.mjs --samples 30",
    "diagnostic:plan": "node tools/reliability/diagnostic-runner.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "libphonenumber-js": "^1.13.11",
    "next": "15.5.18",
    "openai": "^6.16.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
