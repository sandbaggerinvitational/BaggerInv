# Live scoring must point to a COPY of the production spreadsheet while testing.
SCORING_ENVIRONMENT=test
PREVIEW_TIMELINE_DATE=
GOOGLE_SHEETS_ID=replace-with-test-spreadsheet-id
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-test-spreadsheet-id
PREVIEW_SCORING_SHEET_ID=replace-with-test-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account-email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Dedicated, server-only Production synchronization/mirror/archive identity.
# Configuring these values does not enable a worker, Google write, authority,
# or public read source; the exact Production resource/operation gate is also
# required. Never reuse the Preview/live-legacy identity or expose NEXT_PUBLIC.
PRODUCTION_GOOGLE_SERVICE_ACCOUNT_EMAIL=sbi-production-workbook@sandbagger-invitational.iam.gserviceaccount.com
PRODUCTION_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Isolated, Preview-deployment-only Step 11 scoring rehearsal. These values
# authorize a synthetic/virtual run only; they cannot enable live scoring or a
# Google write. Pin both SHA and exact candidate hostname before use.
PRODUCTION_STEP11_SCORING_REHEARSAL_ENABLED=false
PRODUCTION_STEP11_SCORING_REHEARSAL_SHA=
PRODUCTION_STEP11_SCORING_REHEARSAL_HOSTNAME=
PRODUCTION_STEP11_SCORING_REHEARSAL_SECRET=
PRODUCTION_STEP11_S3_FINGERPRINT=
PRODUCTION_STEP11_EXTERNAL_GOOGLE_WRITES_ENABLED=false

# Generate distinct, random values. Never commit real values.
SCORING_SESSION_SECRET=replace-with-at-least-24-random-characters
SCORING_ACCESS_CODE_SALT=replace-with-a-different-random-value
LIVE_ADMIN_SECRET=replace-with-test-admin-password

# Preview-only Supabase scoring shadow. Server variables only; never NEXT_PUBLIC.
# Keep disabled until the Preview database migration has been applied.
SUPABASE_SCORING_MIRROR_ENABLED=false
SCORING_AUTHORITY=google
SCORING_READ_SOURCE=google
MATCH_AUTHORIZATION_SOURCE=google
MY_MATCH_READ_SOURCE=google
HOME_READ_SOURCE=google
GAME_CENTER_READ_SOURCE=google
TOURNAMENT_READ_SOURCE=google
TOURNAMENT_FOUNDATION_READ_SOURCE=google
# Public / current-tournament reads inherit TOURNAMENT_READ_SOURCE when blank.
# Set explicitly to google for an isolated homepage rollback in Preview.
HOMEPAGE_CURRENT_READ_SOURCE=
LEADERBOARDS_CORE_READ_SOURCE=google
NET_SKINS_READ_SOURCE=google
CALCUTTA_READ_SOURCE=google
# Derived presentation gates use application (legacy calculation) or supabase.
MOMENTUM_READ_SOURCE=application
STORYLINES_READ_SOURCE=application
TOURNAMENT_INTELLIGENCE_READ_SOURCE=application
PROJECTION_EDITORIAL_READ_SOURCE=application
FINAL_RECAP_READ_SOURCE=application
SUPABASE_SCORING_MIRROR_URL=https://replace-with-preview-project.supabase.co
SUPABASE_SCORING_MIRROR_SECRET_KEY=replace-with-server-secret-key
# Preview-only finalized scorecard historical mirror. The worker secret is
# server/Supabase-cron only and must never use a NEXT_PUBLIC prefix.
ROUND_SCORECARDS_ARCHIVE_ENABLED=false
ROUND_SCORECARDS_ARCHIVE_WORKER_SECRET=replace-with-at-least-32-random-characters

# Preview-only Tournament Guide projection. Google remains the Director CMS;
# published participant reads come from the versioned Supabase projection.
GUIDE_READ_SOURCE=google
COURSE_PRESENTATION_READ_SOURCE=google
GUIDE_AUTO_SYNC_ENABLED=false
GUIDE_SYNC_TOURNAMENT_ID=2026
GUIDE_SYNC_WORKER_SECRET=replace-with-a-distinct-at-least-32-random-characters
# Preview-only current-year History delivery. The browser cannot select this
# value; Production remains on the existing legacy historical source.
HISTORY_2026_READ_SOURCE=google
COMPLETED_HISTORY_READ_SOURCE=google
SECONDARY_HISTORY_READ_SOURCE=google
HISTORICAL_COURSE_READ_SOURCE=google
HISTORY_2026_TOURNAMENT_ID=2026
# Published Odds, calculation, publication, War Room, and Draft are independent
# boundaries. Google remains available for explicit rollback and Production.
PUBLISHED_ODDS_READ_SOURCE=google
ODDS_CALCULATION_INPUT_SOURCE=google
ODDS_PUBLICATION_AUTHORITY=google
WAR_ROOM_INPUT_SOURCE=google
WAR_ROOM_PREDICTION_SETTINGS_SOURCE_FINGERPRINT=
WAR_ROOM_PREDICTION_SETTINGS_EFFECTIVE_FINGERPRINT=
DRAFT_READ_SOURCE=google
# Participant Auth remains Passport-authoritative until a separate cutover.
PARTICIPANT_IDENTITY_AUTHORITY=passport
SUPABASE_PARTICIPANT_IDENTITY_SHADOW_ENABLED=false
SUPABASE_PARTICIPANT_AUTH_REHEARSAL_ENABLED=false
NEXT_PUBLIC_SUPABASE_AUTH_URL=https://replace-with-preview-project.supabase.co
NEXT_PUBLIC_SUPABASE_AUTH_PUBLISHABLE_KEY=replace-with-browser-safe-publishable-key
# Final participant SMS login. Production remains hard-blocked in code even if
# a Production environment is accidentally set true. Enable only in Preview
# after Turnstile and the intended recipient rollout are ready.
PARTICIPANT_SMS_AUTH_ENABLED=false
# Supabase Auth owns Turnstile token validation. The public site key is safe for
# the browser; the Turnstile secret belongs only in Supabase Auth settings.
PARTICIPANT_SMS_CAPTCHA_REQUIRED=true
PARTICIPANT_SMS_CAPTCHA_CONFIGURED=false
NEXT_PUBLIC_PARTICIPANT_SMS_TURNSTILE_SITE_KEY=
# DESIGNATED permits only the approved rehearsal phone. VERIFIED is the later
# broad-Preview rollout for all canonical VERIFIED phone identifiers.
PARTICIPANT_SMS_PREVIEW_ROLLOUT=DESIGNATED
# Director-only Preview provider proof. This is separate from public SMS login.
PARTICIPANT_SMS_PROVIDER_TEST_ENABLED=false
# Random server-only HMAC key used only to rate-limit the controlled test without storing IP addresses.
PARTICIPANT_PHONE_OTP_RATE_LIMIT_SECRET=replace-with-a-distinct-at-least-32-random-characters
# Shared email/phone Auth request HMAC. May temporarily inherit the phone key,
# but must never reuse a scoring, mirror, provider, or publication secret.
PARTICIPANT_AUTH_RATE_LIMIT_SECRET=replace-with-an-auth-only-at-least-32-random-characters

# Dormant Production-shadow candidate. These values are not a live Production
# cutover: the contract requires an exact non-canonical Vercel hostname,
# Google scoring, Passport on baggerinv.com, and every authoritative feature
# flag below to remain false. Server credentials never use NEXT_PUBLIC.
PRODUCTION_FOUNDATION_ENABLED=false
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_SECRET_KEY=
# Dormant until the exact frozen Production release is explicitly staged.
PRODUCTION_CUTOVER_ACTIVATION_ENABLED=false
PRODUCTION_CUTOVER_PHASE=STATIC_BACKEND
# Maintenance-window only. When set, the deployed phase remains
# SCORING_COMMIT while this exact ceiling authorizes dormant server capability;
# database phase/control rows remain the live activation authority.
PRODUCTION_MAINTENANCE_DEPLOYMENT_CAPABILITY_CONTRACT=
PRODUCTION_MAINTENANCE_DEPLOYMENT_CAPABILITY_CEILING=
PRODUCTION_CUTOVER_EXPECTED_COMMIT_SHA=
PRODUCTION_CUTOVER_EXPECTED_VERCEL_PROJECT_ID=
PRODUCTION_CANONICAL_DOMAIN=https://baggerinv.com
PRODUCTION_CUTOVER_TOURNAMENT_ID=2026
PRODUCTION_CUTOVER_TOURNAMENT_YEAR=2026
PRODUCTION_SUPABASE_DIRECTOR_AUTH_ENABLED=false
PRODUCTION_SUPABASE_ADMIN_SESSION_REVALIDATION_ENABLED=false
PRODUCTION_SHADOW_CANDIDATE_ENABLED=false
PRODUCTION_SHADOW_CANDIDATE_HOSTNAME=
PRODUCTION_SHADOW_CANDIDATE_EXPECTED_COMMIT_SHA=
PRODUCTION_SHADOW_CANDIDATE_EXPECTED_VERCEL_PROJECT_ID=
PRODUCTION_SHADOW_CANDIDATE_AUTH_ENABLED=false
PRODUCTION_SHADOW_CANDIDATE_AUTH_PROVISIONING_ENABLED=false
PRODUCTION_SHADOW_CANDIDATE_SMS_CERTIFIED_ENABLED=false
# Step 11.6 candidate-only Google writer-fence rehearsal. This is non-secret,
# defaults disabled, and cannot activate unless the exact expected SHA and all
# server-side Production-shadow/provider gates also match.
PRODUCTION_STEP11_6_GOOGLE_WRITER_FENCE_REHEARSAL_ENABLED=false
PRODUCTION_STEP11_6_GOOGLE_WRITER_FENCE_EXPECTED_COMMIT_SHA=
# Non-secret trust pins for Ed25519 Vercel provider attestations.
PRODUCTION_VERCEL_PROVIDER_ATTESTATION_ED25519_PUBLIC_KEY=
PRODUCTION_VERCEL_PROVIDER_ATTESTATION_TEAM_ID=
# Candidate-only server secrets for the Step 11.6 module-owned WAF executor.
# Keep both unset outside the exact non-authoritative certified candidate.
PRODUCTION_VERCEL_WAF_EXECUTOR_TOKEN=
PRODUCTION_VERCEL_WAF_EXECUTOR_SIGNING_PRIVATE_KEY=
# Step 12 persistent Google provider fence. This is a separate non-secret
# cutover flag and remains disabled throughout Step 11.6.
PRODUCTION_STEP12_GOOGLE_WRITER_PROVIDER_FENCE_ENABLED=false
PRODUCTION_STEP12_GOOGLE_WRITER_PROVIDER_FENCE_EXPECTED_COMMIT_SHA=
PARTICIPANT_AUTH_CAPTCHA_REQUIRED=true
PARTICIPANT_AUTH_CAPTCHA_CONFIGURED=false
NEXT_PUBLIC_PARTICIPANT_AUTH_TURNSTILE_SITE_KEY=
PRODUCTION_SUPABASE_SCORING_INGRESS_ENABLED=false
PRODUCTION_SUPABASE_GOOGLE_MIRROR_ENABLED=false
PRODUCTION_SUPABASE_WORKERS_ENABLED=false
SCORING_GOOGLE_OUTBOX_WORKER_SECRET=
PRODUCTION_SUPABASE_PUBLIC_READS_ENABLED=false
PRODUCTION_SUPABASE_ODDS_CALCULATION_ENABLED=false
PRODUCTION_SUPABASE_ODDS_GOOGLE_MIRROR_ENABLED=false
# Isolated candidate-only durable Odds rehearsal. This never authorizes a
# publication or Google mirror and still requires the Step 11 rehearsal secret.
PRODUCTION_STEP11_ODDS_REHEARSAL_ENABLED=false
PRODUCTION_STEP11_ODDS_REHEARSAL_SECRET=
# Step 11 isolated candidate only. This allows a valid rehearsal-token request
# to use the service-role Director proof instead of borrowing a browser cookie.
# It is forbidden in live Production and does not authorize publication/mirror.
# Return this to false immediately after final DISABLE + inspect; disabling the
# Odds runtime alone does not revoke this bearer bridge.
PRODUCTION_STEP11_ODDS_SERVICE_AUTH_BRIDGE_ENABLED=false
PRODUCTION_NET_SKINS_CONFIGURED=false
PRODUCTION_CALCUTTA_CONFIGURED=false
PRODUCTION_SUPABASE_ODDS_PUBLICATION_ENABLED=false
PRODUCTION_SUPABASE_AUTH_USER_CREATION_ENABLED=false
# Migration tooling only. Never expose this value to application runtime/browser code.
SUPABASE_DB_URL=postgresql://replace-with-preview-migration-connection
