# Live scoring must point to a COPY of the production spreadsheet while testing.
SCORING_ENVIRONMENT=test
PREVIEW_TIMELINE_DATE=
GOOGLE_SHEETS_ID=replace-with-test-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account-email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Generate distinct, random values. Never commit real values.
SCORING_SESSION_SECRET=replace-with-at-least-24-random-characters
SCORING_ACCESS_CODE_SALT=replace-with-a-different-random-value
LIVE_ADMIN_SECRET=replace-with-test-admin-password

# Preview-only Supabase scoring shadow. Server variables only; never NEXT_PUBLIC.
# Keep disabled until the Preview database migration has been applied.
SUPABASE_SCORING_MIRROR_ENABLED=false
SCORING_AUTHORITY=google
HOME_READ_SOURCE=google
SUPABASE_SCORING_MIRROR_URL=https://replace-with-preview-project.supabase.co
SUPABASE_SCORING_MIRROR_SECRET_KEY=replace-with-server-secret-key
# Preview-only finalized scorecard historical mirror. The worker secret is
# server/Supabase-cron only and must never use a NEXT_PUBLIC prefix.
ROUND_SCORECARDS_ARCHIVE_ENABLED=false
ROUND_SCORECARDS_ARCHIVE_WORKER_SECRET=replace-with-at-least-32-random-characters
# Participant Auth remains Passport-authoritative until a separate cutover.
PARTICIPANT_IDENTITY_AUTHORITY=passport
SUPABASE_PARTICIPANT_IDENTITY_SHADOW_ENABLED=false
SUPABASE_PARTICIPANT_AUTH_REHEARSAL_ENABLED=false
NEXT_PUBLIC_SUPABASE_AUTH_URL=https://replace-with-preview-project.supabase.co
NEXT_PUBLIC_SUPABASE_AUTH_PUBLISHABLE_KEY=replace-with-browser-safe-publishable-key
# Migration tooling only. Never expose this value to application runtime/browser code.
SUPABASE_DB_URL=postgresql://replace-with-preview-migration-connection
